# Copy this file to .env and fill in your keys before running
# `docker compose up -d`. Every setting has a sensible default if omitted
# (see app/config.py) except the API keys, which are required for the
# matching provider to be used at all.

# ---------------------------------------------------------------------------
# Required-ish: without a TMDB key almost nothing works, since TMDB is also
# used to resolve imdb/tvdb ids to a TMDB id in the first place.
# Get one free at https://www.themoviedb.org/settings/api
# ---------------------------------------------------------------------------
TMDB_API_KEY=

# Optional. Without these, TVDB fallback steps are simply skipped (TMDB +
# Metahub still work). Get a key at https://thetvdb.com/dashboard/account/apikey
TVDB_API_KEY=
# Only needed for a "subscriber" (personal) TVDB key, not a company key.
TVDB_SUBSCRIBER_PIN=

# Optional. Only used for the cult-classic / based-on-true-story /
# metacritic-must-see / Oscar-keyword sashes. Everything else (Golden
# Globe, Emmy, festival, trending, top-rated, studio/director/cast, release
# status, structural sashes) works without this. Get a free key at
# https://mdblist.com/preferences/#api-access
MDBLIST_API_KEY=
MDBLIST_API_KEY_2=

# ---------------------------------------------------------------------------
# Image sizes (TMDB size tokens)
# Posters:            w92 / w154 / w185 / w342 / w500 / w780 / original
# Backdrops & logos:  w300 / w780 / w1280 / original
# ---------------------------------------------------------------------------
TMDB_POSTER_SIZE=w780
TMDB_BACKDROP_SIZE=original
TMDB_LOGO_SIZE=original

# ---------------------------------------------------------------------------
# Caching (hours unless noted)
# ---------------------------------------------------------------------------
SELECTION_CACHE_TTL_HOURS=24
NEGATIVE_CACHE_TTL_HOURS=3
RENDER_CACHE_TTL_HOURS=24
HTTP_CACHE_MAX_AGE_SECONDS=86400

# ---------------------------------------------------------------------------
# Resource usage / concurrency ("cpu intensity")
# RENDER_WORKERS=auto sizes the sash-rendering thread pool to the container's
# actual CPU limit (honours docker-compose's `cpus:`, not just the host's
# core count) — set a number to override.
# ---------------------------------------------------------------------------
RENDER_WORKERS=auto
UPSTREAM_CONCURRENCY=16
HTTP_TIMEOUT_SECONDS=12

# ---------------------------------------------------------------------------
# IMDb ratings dataset (drives the "Top Rated" sash)
# TOP_RATED_MIN_SCORE is on IMDb's own 0-10 scale (8.5 = "85+" on a 0-100 scale).
# ---------------------------------------------------------------------------
IMDB_DATASET_ENABLED=true
IMDB_DATASET_REFRESH_HOURS=24
IMDB_DATASET_MIN_VOTES=1000
TOP_RATED_MIN_SCORE=8.5

# ---------------------------------------------------------------------------
# Release status (movies: Cinema/Streaming/Physical/Production; TV:
# Airing/Ended/Cancelled) — sourced from TMDB's own /release_dates endpoint.
# ---------------------------------------------------------------------------
CINEMA_MAX_AGE_YEARS=3

# Optional early "already streaming" signal from r/movieleaks (via the
# Arctic Shift archive API), used to upgrade Cinema/Production to Streaming
# before TMDB publishes an official digital date. Off by default since it's
# a third-party source outside TMDB/TVDB/Metahub/MDBList.
DIGITAL_RELEASE_ENABLED=false
DIGITAL_RELEASE_MIN_AGE_DAYS=1
DIGITAL_RELEASE_MAX_AGE_DAYS=30

# ---------------------------------------------------------------------------
# Trending source. Leave blank to use TMDB's own daily trending endpoint.
# Or paste a public MDBList list URL (no MDBList API key needed for this —
# a public list's /json export is unauthenticated), e.g.:
#   TRENDING_SOURCE_MOVIE=https://mdblist.com/lists/garycrawfordgc/latest-tmdb-trending-movies
#   TRENDING_SOURCE_TV=https://mdblist.com/lists/garycrawfordgc/latest-tmdb-trending-shows
# Any other endpoint returning {"results":[{"id":603}, ...]} (TMDB-shaped)
# also works.
# ---------------------------------------------------------------------------
TRENDING_SOURCE_MOVIE=
TRENDING_SOURCE_TV=
TRENDING_CACHE_TTL_HOURS=1
TRENDING_FETCH_COUNT=40
TRENDING_BROAD_FETCH_COUNT=100

# ---------------------------------------------------------------------------
# Sash rendering
# ---------------------------------------------------------------------------
SASH_ENABLED=true
SASH_HEIGHT_RATIO=0.034
SASH_FONT_SIZE_RATIO=0.62
# One of: Inter-Bold.ttf, Oswald-Bold.ttf, Ubuntu-Bold.ttf, BebasNeue-Bold.ttf
SASH_FONT=Oswald-Bold.ttf
# Comma-separated slot list overriding app/config.py's SASH_PRIORITY default
# (see that file for every available slot name). Leave blank to use the
# default order.
SASH_PRIORITY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=20
LOG_LEVEL=info

# Optional shared secret — if set, add ?access_key=... to every AIOMetadata
# URL you configure, and PosterBridge's own /stats endpoint requires it too.
# (Not required for /poster, /backdrop, /logo — those are meant to be hit
# by Stremio clients, which can't send custom headers.)
ACCESS_KEY=